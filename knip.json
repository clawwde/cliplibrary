{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "playwright": false,
  "entry": [
    "scripts/*.ts",
    "src/{schemas,project,core,compositions}/index.ts",
    "src/compositions/entry.ts",
    "playwright.config.ts",
    "e2e/**/*.spec.ts"
  ],
  "project": ["src/**/*.{ts,tsx}", "tests/**/*.{ts,tsx}", "e2e/**/*.ts", "scripts/**/*.ts"],
  "ignore": ["src/components/ui/**"],
  "ignoreDependencies": ["tw-animate-css", "tailwindcss"]
}
