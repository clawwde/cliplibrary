{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.ts"],
      "project": ["scripts/**/*.ts"]
    },
    "apps/web": {
      "playwright": false,
      "entry": ["playwright.config.ts", "e2e/**/*.spec.ts"],
      "project": ["src/**/*.{ts,tsx}", "tests/**/*.{ts,tsx}", "e2e/**/*.ts"],
      "ignore": ["src/components/ui/**"],
      "ignoreDependencies": ["tw-animate-css", "tailwindcss"]
    },
    "apps/render": {
      "entry": ["src/render-all.ts"],
      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["@cliplibrary/compositions"]
    },
    "packages/schemas": {
      "entry": ["tests/**/*.test.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    },
    "packages/core": {
      "entry": ["tests/**/*.test.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    },
    "packages/compositions": {
      "entry": ["tests/**/*.test.ts"],
      "project": ["src/**/*.{ts,tsx}", "tests/**/*.ts"]
    }
  }
}
