{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**",
      "!**/.claude",
      "!**/node_modules",
      "!**/.next",
      "!**/.turbo",
      "!**/dist",
      "!**/build",
      "!**/coverage",
      "!**/playwright-report",
      "!**/test-results",
      "!**/*.gen.ts",
      "!**/next-env.d.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf",
    "bracketSpacing": true
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always",
      "bracketSameLine": false,
      "quoteProperties": "asNeeded"
    }
  },
  "json": { "formatter": { "enabled": true }, "parser": { "allowComments": false } },
  "css": {
    "parser": { "tailwindDirectives": true },
    "formatter": { "enabled": true },
    "linter": { "enabled": true }
  },
  "assist": { "enabled": true, "actions": { "source": { "organizeImports": "on" } } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": {
        "preset": "recommended",
        "useSemanticElements": "error",
        "noStaticElementInteractions": "error",
        "useFocusableInteractive": "error",
        "useAriaPropsSupportedByRole": "error",
        "useValidAutocomplete": "error"
      },
      "complexity": {
        "preset": "recommended",
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": { "maxAllowedComplexity": 18 }
        },
        "noForEach": "error",
        "noUselessStringConcat": "error",
        "noVoid": "error",
        "useDateNow": "error",
        "useSimplifiedLogicExpression": "error",
        "useWhile": "error",
        "useLiteralKeys": "off"
      },
      "correctness": {
        "preset": "recommended",
        "noUnusedImports": "error",
        "noUnusedVariables": "error",
        "noUnusedFunctionParameters": "error",
        "noUnusedPrivateClassMembers": "error",
        "noPrivateImports": "error",
        "useExhaustiveDependencies": "error",
        "useHookAtTopLevel": "error"
      },
      "performance": {
        "preset": "recommended",
        "noAccumulatingSpread": "error",
        "noDelete": "error"
      },
      "security": { "preset": "none" },
      "style": {
        "preset": "recommended",
        "noNonNullAssertion": "error",
        "noParameterAssign": "error",
        "noNegationElse": "error",
        "noYodaExpression": "error",
        "noInferrableTypes": "error",
        "noUselessElse": "error",
        "noEnum": "error",
        "noNestedTernary": "error",
        "noSubstr": "error",
        "useConst": "error",
        "useImportType": "error",
        "useExportType": "error",
        "useNodejsImportProtocol": "error",
        "useTemplate": "error",
        "useShorthandAssign": "error",
        "useCollapsedElseIf": "error",
        "useCollapsedIf": "error",
        "useConsistentArrayType": { "level": "error", "options": { "syntax": "shorthand" } },
        "useConsistentBuiltinInstantiation": "error",
        "useDefaultParameterLast": "error",
        "useExponentiationOperator": "error",
        "useForOf": "error",
        "useFragmentSyntax": "error",
        "useNumberNamespace": "error",
        "useSelfClosingElements": "error",
        "useShorthandFunctionType": "error",
        "useSingleVarDeclarator": "error",
        "useThrowNewError": "error",
        "useThrowOnlyError": "error",
        "useAsConstAssertion": "error",
        "useAtIndex": "error",
        "useTrimStartEnd": "error",
        "useArrayLiterals": "error",
        "useFilenamingConvention": {
          "level": "error",
          "options": { "requireAscii": true, "filenameCases": ["kebab-case", "export"] }
        }
      },
      "suspicious": {
        "preset": "recommended",
        "noExplicitAny": "error",
        "noDoubleEquals": "error",
        "noArrayIndexKey": "error",
        "noConsole": { "level": "error", "options": { "allow": ["warn", "error", "info"] } },
        "noDebugger": "error",
        "noEmptyBlockStatements": "error",
        "noEvolvingTypes": "error",
        "noFocusedTests": "error",
        "noSkippedTests": "error",
        "noVar": "error",
        "useAwait": "error",
        "useErrorMessage": "error",
        "noTsIgnore": "error",
        "noConstantBinaryExpressions": "error",
        "useGuardForIn": "error",
        "noAlert": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/globals.css"],
      "linter": { "rules": { "complexity": { "noImportantStyles": "off" } } }
    },
    {
      "includes": ["packages/compositions/**"],
      "linter": { "rules": { "suspicious": { "noArrayIndexKey": "off" } } }
    },
    {
      "includes": ["apps/web/**"],
      "linter": {
        "rules": {
          "suspicious": { "noArrayIndexKey": "off" },
          "a11y": { "useMediaCaption": "off" }
        }
      }
    },
    {
      "includes": ["apps/web/src/components/ui/**"],
      "linter": {
        "rules": {
          "style": {
            "noNestedTernary": "off",
            "useNamingConvention": "off",
            "noParameterAssign": "off"
          },
          "complexity": { "noExcessiveCognitiveComplexity": "off" }
        }
      }
    },
    {
      "includes": ["**/*.test.ts", "**/*.test.tsx", "**/tests/**", "**/e2e/**", "**/*.spec.ts"],
      "linter": {
        "rules": {
          "suspicious": { "noExplicitAny": "off", "noConsole": "off" },
          "style": { "noNonNullAssertion": "off" },
          "complexity": { "noExcessiveCognitiveComplexity": "off" }
        }
      }
    }
  ]
}
