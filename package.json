{
  "name": "cliplibrary",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "bun test tests --timeout 20000",
    "test:coverage": "bun test tests --coverage --timeout 20000",
    "test:e2e": "playwright test",
    "render": "bun run src/render/render-all.ts",
    "render-one": "bun run src/render/render-one.ts",
    "render-project": "bun run src/render/render-project-one.ts",
    "check:comments": "bun run scripts/strip-comments.ts --check",
    "check:em-dashes": "bun run scripts/check-em-dashes.ts",
    "check:repository": "bun run scripts/check-repository.ts",
    "knip": "knip",
    "verify": "bun run lint && bun run check:comments && bun run check:em-dashes && bun run check:repository && bun run knip && bun run typecheck && bun run test",
    "prepare": "lefthook install || true"
  },
  "dependencies": {
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.1",
    "@remotion/bundler": "4.0.534",
    "@remotion/google-fonts": "4.0.534",
    "@remotion/player": "4.0.534",
    "@remotion/renderer": "4.0.534",
    "@remotion/three": "4.0.534",
    "@tailwindcss/postcss": "4.1.14",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.550.0",
    "minisearch": "7.2.0",
    "next": "16.4.0",
    "radix-ui": "1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.534",
    "server-only": "0.0.1",
    "tailwind-merge": "3.3.1",
    "tailwindcss": "4.1.14",
    "three": "0.186.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@happy-dom/global-registrator": "20.11.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/bun": "1.4.2",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "knip": "6.41.0",
    "lefthook": "2.1.16",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3"
  }
}
